.env
.venv/
# Smoke runs stay local; the real ablation output is a required submission artifact.
results/*
!results/state-lifetime-v1/
# Base-vs-tuned numbers, training logs, and the checkpoint manifest are all required
# submission artifacts a grader has to be able to read without an account.
!results/base-vs-tuned/
!results/train/
!results/checkpoints.jsonl
# The v2 data change and the probe that motivated it. Same reasoning: these are the raw
# judge transcripts behind the Early Submission tables, not smoke runs. probe-v2-run1 is
# the superseded first run, kept because the Brainlift cites it for judge variance.
!results/probe-v1/
!results/probe-v2/
!results/probe-v2-run1/
!results/base-vs-tuned-v2/
!results/train-v2/
!results/delta-v1-v2.md
# The 24 mislocalisation transcripts the demo and the Brainlift both argue from, tabulated.
# Derived from results/base-vs-tuned/trials.jsonl; the filter that regenerates it is in the file.
!results/failure-audit-v1.md
__pycache__/
*.pyc
.DS_Store
# Merged weights are large and reproducible from the Hub; the checkpoint manifest is not.
checkpoints/

# Build output from an editable install.
*.egg-info/
